{
  "name": "earth-chronicle",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data": "node tools/build-data.mjs",
    "data:quick": "node tools/build-data.mjs --quick",
    "blender": "\"D:/install/blender/blender.exe\" --background --python blender/build_earth.py",
    "blender:palace": "\"D:/install/blender/blender.exe\" --background --python forbidden-city/build_forbidden_city.py -- --samples 128 --save",
    "blender:palace:preview": "\"D:/install/blender/blender.exe\" --background --python forbidden-city/build_forbidden_city.py -- --pct 40 --samples 16 --out forbidden-city/output/forbidden_city/preview.png",
    "blender:westlake": "\"D:/install/blender/blender.exe\" --background --python west-lake/build_west_lake.py -- --samples 128 --save",
    "blender:westlake:preview": "\"D:/install/blender/blender.exe\" --background --python west-lake/build_west_lake.py -- --pct 40 --samples 16 --out west-lake/output/west_lake/preview.png",
    "blender:palace:web": "\"D:/install/blender/blender.exe\" --background --python forbidden-city/build_forbidden_city.py -- --export-glb public/dioramas/forbidden-city",
    "blender:westlake:web": "\"D:/install/blender/blender.exe\" --background --python west-lake/build_west_lake.py -- --export-glb public/dioramas/west-lake",
    "blender:trees:web": "\"D:/install/blender/blender.exe\" --background --python tools/diorama_impostors.py -- --samples 32",
    "blender:crane": "\"D:/install/blender/blender.exe\" --background --python yellow-crane/build_yellow_crane.py -- --samples 64 --save",
    "blender:crane:preview": "\"D:/install/blender/blender.exe\" --background --python yellow-crane/build_yellow_crane.py -- --pct 40 --samples 16 --out yellow-crane/output/yellow_crane/preview.png",
    "blender:crane:web": "\"D:/install/blender/blender.exe\" --background --python yellow-crane/build_yellow_crane.py -- --export-glb public/dioramas/yellow-crane",
    "web:optimize": "python tools/optimize_web_assets.py"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "earcut": "^3.2.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "topojson-client": "^3.1.0",
    "vite": "^8.2.2",
    "world-atlas": "^2.0.2"
  }
}
